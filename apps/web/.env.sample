# Supabase — project connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter — powers semantic search embeddings (text-embedding-3-small, 1536d)
NEXT_PUBLIC_OPENROUTER_API_KEY=your-openrouter-api-key

# Feature flags
SUPABASE_PRODUCTS_ENABLED=true    # true = query Supabase; false = JSON file fallback
SUPABASE_RAG_ENABLED=true         # REQUIRED: Supabase pgvector RAG (Vectra fallback removed)
SYSTEM_PROMPT_VERSION=v5.0        # Prompt version (v2.1, v3.0, v4.0, v5.0)

# Flat-lay generation
FLAT_LAY_USE_VISION=true          # true = vision-to-text (95% success); false = hybrid real-product compositing (20-30% success)
HYBRID_FLATLAY_USE_AI_BACKGROUND=false    # Generate AI backgrounds for hybrid mode
HYBRID_FLATLAY_ALLOW_AI_FALLBACK=true     # Fall back to AI-only on hybrid failure
